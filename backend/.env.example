# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# SMTP settings for password reset emails (example: Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
MAIL_FROM="VyaparFlow <your_email@gmail.com>"

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/small_business_db

# JWT Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_in_production
JWT_EXPIRE=7d

# Google Identity Services Web Client ID (same ID as the frontend)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Super Admin Provisioning Defaults (Used by npm run provision-admin)
ADMIN_EMAIL=admin@vyaparflow.com
ADMIN_PASSWORD=VyaparAdmin#2026!
ADMIN_NAME=Super Administrator
ADMIN_BUSINESS=VyaparFlow Headquarters
